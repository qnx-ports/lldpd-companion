# Contributor: Francesco Colista <fcolista@alpinelinux.org>
# Maintainer: Francesco Colista <fcolista@alpinelinux.org>
pkgname=lldpd
pkgver=1.0.19
pkgrel=0
pkgdesc="Implementation of IEEE 802.1ab"
url="https://lldpd.github.io/"
arch="all"
license="ISC"
makedepends="autoconf automake libtool 
	libevent-dev libxml2-dev jansson-dev
	perl-dev readline-dev check check-dev"
subpackages="
	$pkgname-dev
	$pkgname-doc
	$pkgname-bash-completion
	"
pkgusers="lldpd"
pkggroups="lldpd"
source="$pkgname-$pkgver.tar.gz::https://github.com/qnx-ports/lldpd/archive/refs/tags/qnx-$pkgver-p0.tar.gz"
builddir="$srcdir/$pkgname-qnx-$pkgver-p0"

prepare() {
	# this should be shipped with the release tarball
	echo $pkgver > .dist-version
	"$builddir"/autogen.sh
	default_prepare
}

build() {

	export LDFLAGS="$LDFLAGS -lsocket -lregex"
	./configure \
		--host=x86_64-x86pc-nto-qnx8.0.0 \
		--build=x86_64-x86pc-nto-qnx8.0.0 \
		--prefix=/usr \
		--localstatedir=/var \
		--sysconfdir=/etc \
		--enable-static=no \
		--enable-min-macro
	make
}

check() {
	make check
}

package() {
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
	make DESTDIR="$pkgdir" install
}

sha512sums="
2931fb266e17c5bfc337e43e07e131136f98ca9db1ef33bf0db88d0b139af08d40d37e43a9268a802e5de55651d3644ab4010d52bfc99c895ecd8cf5a78e1cee  lldpd-1.0.19.tar.gz
"
