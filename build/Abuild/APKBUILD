# Contributor: Francesco Colista <fcolista@alpinelinux.org>
# Maintainer: Francesco Colista <fcolista@alpinelinux.org>
pkgname=lldpd
pkgver=1.0.19_p0
pkgrel=0
pkgdesc="Implementation of IEEE 802.1ab"
url="https://lldpd.github.io/"
arch="all"
license="ISC"
makedepends="autoconf automake libtool 
	libevent-dev libxml2-dev jansson-dev
	perl-dev readline-dev check check-dev"
subpackages="
	$pkgname-dev
	$pkgname-doc
	$pkgname-bash-completion
	"
pkgusers="lldpd"
pkggroups="lldpd"
source="$pkgname-$pkgver.tar.gz::https://github.com/qnx-ports/lldpd/archive/refs/tags/qnx-$pkgver.tar.gz"
builddir="$srcdir/$pkgname-qnx-$pkgver"

prepare() {
	# this should be shipped with the release tarball
	echo $pkgver > .dist-version
	"$builddir"/autogen.sh
	default_prepare
}

build() {

	export LDFLAGS="$LDFLAGS -lsocket -lregex"
	./configure \
		--host=x86_64-x86pc-nto-qnx8.0.0 \
		--build=x86_64-x86pc-nto-qnx8.0.0 \
		--prefix=/usr \
		--localstatedir=/var \
		--sysconfdir=/etc \
		--enable-static=no \
		--enable-min-macro
	make
}

check() {
	make check
}

package() {
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
	make DESTDIR="$pkgdir" install
}

sha512sums="
0fa516712e8c91641c60ecd93b6b9763c730d19ef20f4ffcbf133c4f358eeb08de1a11bbfb67ebf44df9f4a70508db3f285367acf460de0c3fa1ffb56a8560be  lldpd-1.0.19_p0.tar.gz
"
