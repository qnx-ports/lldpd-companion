# Contributor: Francesco Colista <fcolista@alpinelinux.org>
# Maintainer: Francesco Colista <fcolista@alpinelinux.org>
pkgname=lldpd
pkgver=1.0.19
pkgrel=${pkgrel:-0}
pkgdesc="Implementation of IEEE 802.1ab"
url="https://lldpd.github.io/"
arch="all"
license="ISC"
makedepends="autoconf automake libtool 
	libevent-dev libxml2-dev jansson-dev
	perl-dev readline-dev check check-dev"
subpackages="
	$pkgname-dev
	$pkgname-doc
	$pkgname-bash-completion
	"
pkgusers="lldpd"
pkggroups="lldpd"
source="$pkgname-$pkgver.tar.gz::https://github.com/qnx-ports/lldpd/archive/refs/tags/qnx-$pkgver-1.tar.gz"
builddir="$srcdir/$pkgname-qnx-$pkgver-1"

prepare() {
	# this should be shipped with the release tarball
	echo $pkgver > .dist-version
	"$builddir"/autogen.sh
	default_prepare
}

build() {

	export LDFLAGS="$LDFLAGS -lsocket -lregex"
	./configure \
		--host=x86_64-x86pc-nto-qnx8.0.0 \
		--build=x86_64-x86pc-nto-qnx8.0.0 \
		--prefix=/usr \
		--localstatedir=/var \
		--sysconfdir=/etc \
		--enable-static=no \
		--enable-min-macro
	make
}

check() {
	make check
}

package() {
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
	make DESTDIR="$pkgdir" install
}



options="$options ${DISABLE_CHECK:+!check}"
sha512sums="
e71256fc023746e88bf808442767a1425758e424e9c5c88828afb0bcb750053aaf48f36940f048aef21860408d7f073aed45878bc17581807482b9d89c2da779  lldpd-1.0.19.tar.gz
"
